---
- name: Enable Remote Desktop (RDP)
  hosts: windows
  gather_facts: true
  become: false          # WinRM already runs as the connecting user (usually admin)

  tasks:
    - name: Enable RDP (set fDenyTSConnections = 0)
      ansible.windows.win_regedit:
        path: HKLM:\System\CurrentControlSet\Control\Terminal Server
        name: fDenyTSConnections
        data: 0
        type: dword

    - name: Ensure Terminal Services (TermService) is running and set to Automatic
      ansible.windows.win_service:
        name: TermService
        start_mode: auto
        state: started

    - name: Enable Remote Desktop firewall rules (TCP + UDP)
      ansible.windows.win_powershell:
        script: |
          Enable-NetFirewallRule -DisplayGroup "Remote Desktop" -ErrorAction SilentlyContinue
          # Fallback: explicitly enable the common User Mode rules if the group name differs
          Enable-NetFirewallRule -Name "RemoteDesktop-UserMode-In-TCP" -ErrorAction SilentlyContinue
          Enable-NetFirewallRule -Name "RemoteDesktop-UserMode-In-UDP" -ErrorAction SilentlyContinue
      changed_when: false   # PowerShell Enable-* is effectively idempotent here

    - name: (Optional) Require Network Level Authentication (NLA)
      ansible.windows.win_regedit:
        path: HKLM:\System\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp
        name: UserAuthentication
        data: 1
        type: dword
      when: rdp_require_nla | default(true) | bool






































